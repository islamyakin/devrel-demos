# Agent image for Cloud Run (worker pool + sandboxes).
#
# Sandboxes see THIS image's root file system, read-only. That means:
#  1. Every toolchain a submission needs (git, node, python, go, make) must be
#     installed here, because the sandbox borrows it.
#  2. Never COPY credentials, keys or .env files into this image. A sandbox
#     cannot reach env vars or the metadata server, but it can read files.
FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl ca-certificates build-essential jq ripgrep tree file procps unzip \
    && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g pnpm yarn \
    && curl -fsSL https://go.dev/dl/go1.26.2.linux-amd64.tar.gz | tar -xzC /usr/local \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev
COPY src ./src

ENV PATH="/app/.venv/bin:/usr/local/go/bin:$PATH" \
    PYTHONPATH="/app" \
    AGENT_TYPE="cloudrun"

ENTRYPOINT ["python", "-m", "src.main"]
